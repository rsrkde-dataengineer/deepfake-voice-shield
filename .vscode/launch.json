{
  "version": "0.2.0",
  "configurations": [
    { "name": "Dashboard", "type": "debugpy", "request": "launch", "module": "streamlit",
      "args": ["run", "app.py"], "cwd": "${workspaceFolder}" },
    { "name": "Dashboard (models live, .venv-ml)", "type": "debugpy", "request": "launch", "module": "streamlit",
      "args": ["run", "app.py"], "cwd": "${workspaceFolder}", "python": "${workspaceFolder}/.venv-ml/bin/python",
      "env": { "PYTORCH_ENABLE_MPS_FALLBACK": "1" } },
    { "name": "CLI: all calls", "type": "debugpy", "request": "launch", "module": "vshield.cli",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "CLI: voice clone, turn by turn", "type": "debugpy", "request": "launch", "module": "vshield.cli",
      "args": ["voice_clone"], "cwd": "${workspaceFolder}", "console": "integratedTerminal" },
    { "name": "Tests", "type": "debugpy", "request": "launch", "module": "pytest", "cwd": "${workspaceFolder}" }
  ]
}
